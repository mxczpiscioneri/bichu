{
  "name": "bichu",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reactvision/react-viro": "^3.0.1",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "assets:fetch": "tsx scripts/fetch-legacy-assets.ts && npm run assets:registry",
    "assets:registry": "tsx scripts/generate-asset-registry.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate": "npm run lint && npm run typecheck && npm run validate:content && npm test",
    "start:ar": "BICHU_AR=1 expo start --dev-client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "run:android": "expo run:android",
    "run:ios": "expo run:ios",
    "run:android:ar": "BICHU_AR=1 expo run:android",
    "run:ios:ar": "BICHU_AR=1 expo run:ios"
  },
  "private": true,
  "overrides": {
    "@react-native/jest-preset": "0.86.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@reactvision/react-viro"
        ]
      }
    }
  }
}
